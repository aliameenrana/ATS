{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ats-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",

  // nodejs_compat needed for mammoth (DOCX parsing) and Buffer usage
  // inside unpdf's dependency chain.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // MCP-only tool, publicly reachable at the workers.dev URL below so any
  // MCP-compatible AI agent can call it directly (registered in the MCP
  // registry). No auth secret -- cost/abuse control is the per-client and
  // global-daily limits in src/ratelimit.ts. aliameen.com's Pages service
  // binding (functions/ats/api/[[path]].ts) is a same-origin convenience
  // path, not the only way in.
  "workers_dev": true,

  // Submissions (parsed resume text + score + suggestions, kept
  // indefinitely -- see src/db.ts) and a rolling rate-limit counter.
  // Provision with: npx wrangler d1 create ats-db
  // Then apply migrations/0001_ats_schema.sql via:
  //   npx wrangler d1 execute ats-db --remote --file=migrations/0001_ats_schema.sql
  "d1_databases": [
    { "binding": "ATS_DB", "database_name": "ats-db", "database_id": "e3474bbd-4a52-48fc-b865-92622206238e" }
  ]

  // SECRETS (never committed, not listed under "vars"):
  //   GROQ_API_KEY     -- npx wrangler secret put GROQ_API_KEY
  //     (qualitative-suggestions pass; https://console.groq.com)
}
